      "name": "0. Protected application list requires a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected application list rejects missing token', () => pm.response.to.have.status(401));",
              "pm.test('Unauthorized response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Unauthorized response has a useful message', () => pm.expect(pm.response.json().message).to.eql('Authentication required.'));"
            ]
          }
        }
      ],
