              "followUp.setDate(followUp.getDate() + 2);",
              "pm.collectionVariables.set('followUpDate', followUp.toISOString().slice(0, 10));",
              "const interview = new Date();",
              "interview.setDate(interview.getDate() + 1);",
              "pm.collectionVariables.set('interviewDate', `${interview.toISOString().slice(0, 10)}T10:00:00`);"
