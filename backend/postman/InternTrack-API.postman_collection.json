          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application creation returns 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Created application has the expected company', () => pm.expect(body.companyName).to.eql('Postman Example Co'));",
              "pm.test('Created application has a database ID', () => pm.expect(body.id).to.be.a('number'));",
              "pm.collectionVariables.set('applicationId', body.id);"
            ]
          }
        }
