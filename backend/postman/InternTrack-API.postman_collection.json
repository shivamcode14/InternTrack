              "pm.test('Dashboard total matches the one application created for user A', () => pm.expect(stats.total).to.eql(1));",
              "pm.test('Dashboard counts APPLIED and zero-fills unused statuses', () => { pm.expect(stats.countsByStatus.APPLIED).to.eql(1); pm.expect(stats.countsByStatus.SAVED).to.eql(0); pm.expect(stats.countsByStatus.REJECTED).to.eql(0); });",
              "pm.test('Dashboard recent applications contain the created record', () => pm.expect(stats.recent.some(item => item.id === Number(pm.collectionVariables.get('applicationId')))).to.eql(true));"
            ]
          }
        }
