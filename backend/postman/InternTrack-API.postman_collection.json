    {
      "name": "1. Register unique user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', `wk2-${Date.now()}-${Math.floor(Math.random() * 100000)}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration returns 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Registration returns a token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.test('Registration returns the new user email', () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email')));",
              "pm.test('Registration does not return a password', () => pm.expect(body.user).not.to.have.property('password'));",
              "const encodedPayload = body.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "const paddedPayload = encodedPayload + '='.repeat((4 - encodedPayload.length % 4) % 4);",
              "const claims = JSON.parse(CryptoJS.enc.Base64.parse(paddedPayload).toString(CryptoJS.enc.Utf8));",
              "pm.test('JWT subject is the registered user ID', () => pm.expect(claims.sub).to.eql(String(body.user.id)));",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Week Two Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
